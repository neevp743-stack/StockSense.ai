# StockSense AI — Production Environment Variables Example
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' file to Git or public repositories.

# Environment Mode: 'development' or 'production'
ENVIRONMENT=production

# Real-time WebSocket Data Provider Configuration
REALTIME_PROVIDER=FINNHUB
REALTIME_API_KEY=your_realtime_api_key_here
REALTIME_WS_URL=wss://ws.finnhub.io
STALE_TICK_THRESHOLD_SECONDS=30

# Database Configuration (SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./backend/stocksense.db

# CORS Security Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Coinbase Public WebSocket (no API key required for public channels)
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
COINBASE_PRODUCTS=BTC-USD,SOL-USD

# Twelve Data API — XAU/USD Gold Market Data
# Get your free API key at https://twelvedata.com
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
